  missionDuplicationId    String
  name                    String
  isShared                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now())
  temp_mission            TempMission               @relation(fields: [missionDuplicationId], references: [id], onDelete: Cascade)
