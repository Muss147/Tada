{
  "name": "@tada/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:api": "tsx watch --env-file=.env.local src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "clean": "git clean -xdf .turbo node_modules",
    "lint": "biome lint",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.8",
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^1.2.0",
    "@tada/email": "workspace:*",
    "@tada/logger": "workspace:*",
    "@tada/supabase": "workspace:*",
    "@tada/ui": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "hono": "^4.11.3",
    "jose": "^6.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4"
  }
}
